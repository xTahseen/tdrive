# ──────────────────────────────────────────────────────────────────────────
# tdrive — example environment file
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# Lines marked REQUIRED must be set or the bot will refuse to start
# (see Config.validate() in config.py). Everything else has a safe default
# and can be left blank / removed.
#
# Note: don't put comments on the same line as a value below — python-dotenv
# takes everything after "=" literally, including "# ..." text, so a trailing
# comment would become part of the value instead of being ignored.
# ──────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org/apps
# Get BOT_TOKEN from @BotFather on Telegram
# REQUIRED — numeric
API_ID=
# REQUIRED
API_HASH=
# REQUIRED
BOT_TOKEN=

# ── MongoDB ─────────────────────────────────────────────────────────────────
# If you're using the included docker-compose.yml, this is overridden to
# mongodb://mongo:27017 automatically — you don't need to set it for Docker.
# Only needed here if running bot.py directly (no Docker).
# REQUIRED (unless using docker-compose)
MONGO_URI=mongodb://localhost:27017
# optional — default: gdrive_bot
DB_NAME=gdrive_bot

# ── Google Cloud / OAuth ─────────────────────────────────────────────────────
# From https://console.cloud.google.com/ — create an OAuth 2.0 Client ID
# (enable the Google Drive API first).
# REQUIRED
GOOGLE_CLIENT_ID=
# REQUIRED
GOOGLE_CLIENT_SECRET=
# Redirect URI configured on the OAuth client. Leave as-is for the
# out-of-band/manual-code flow, or set to your own callback URL.
# optional — default: http://localhost
OAUTH_REDIRECT_URI=http://localhost

# ── Uploads ───────────────────────────────────────────────────────────────
# Max accepted file size, in bytes. Value below is 2 GB.
# optional — default: 2147483648 (2 GB)
MAX_FILE_SIZE=2147483648
# Where files are downloaded to before being uploaded to Drive.
# If using docker-compose.yml, this is overridden to /app/downloads
# automatically (mapped to ./downloads on the host) — no need to set it.
# optional — default: ./downloads
TEMP_DIR=./downloads

# ── Upload queue ────────────────────────────────────────────────────────────
# How many uploads can run at the same time, across all users combined.
# optional — default: 4
UPLOAD_WORKERS=4
# How many files a single user can have queued at once before new
# uploads are rejected with "you already have N files queued".
# optional — default: 5
UPLOAD_QUEUE_PER_USER=5

# ── Admin / logging ──────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to run /stats.
# Example: ADMIN_IDS=123456789,987654321
# optional — /stats is hidden if unset
ADMIN_IDS=
# Telegram group/channel ID where activity logs (new users, blocks,
# uploads) are posted. Use a negative ID for groups/channels.
# Example: LOG_GROUP_ID=-1001234567890
#
# Leave commented out (not just blank) to disable — an empty value here
# will cause a startup error, so either set a real ID or leave this as-is.
# optional — logs only go to stdout if unset
#LOG_GROUP_ID=

# ── WebUI (optional) ──────────────────────────────────────────────────────
# Set to true to enable the aiohttp-based web dashboard alongside the bot.
# optional — default: false
WEBUI_ENABLED=false
# optional — default: 0.0.0.0
WEBUI_HOST=0.0.0.0
# optional — default: 8080
WEBUI_PORT=8080
# Public URL the WebUI is reachable at (used in links sent to users).
# optional — default: http://localhost:8080
WEBUI_BASE_URL=http://localhost:8080
# Used to sign WebUI session cookies — set a long random string in
# production. The bot warns on startup if this is left as the default.
# optional, but change it for production!
WEBUI_SECRET_KEY=change-me-in-production
